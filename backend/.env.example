# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=market_ai_db

# Two-Factor Auth Configuration
TWOFACTOR_API_KEY=your_2fa_api_key_here

# Facebook / Meta Integration Configuration
FB_APP_ID=your_facebook_app_id_here
FB_APP_SECRET=your_facebook_app_secret_here
FB_REDIRECT_URI=your_facebook_oauth_callback_url_here
FB_CONFIG_ID=your_facebook_config_id_here

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Apify Integration Configuration
APIFY_TOKEN=your_apify_api_token_here
